# ---------------------------------------------------------------------------
# Environment variables (optional). The application reads real environment
# variables only - it does not load this file itself. Set them in your shell
# before starting the app, e.g. PowerShell:
#
#     $env:STOCKFORECAST_DEFAULT_TICKER = "MSFT"
#     python app.py
# ---------------------------------------------------------------------------

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
STOCKFORECAST_LOG_LEVEL=INFO

# Default ticker shown in the interface when config/app.yaml is unchanged.
STOCKFORECAST_DEFAULT_TICKER=AAPL

# Random seed for model reproducibility.
STOCKFORECAST_SEED=42
